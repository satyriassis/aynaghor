graph TD;
    User[User Interface] -->|submits prompts| Engine[Core Engine];
    Engine -->|routes requests| Gemini[Google Gemini API];
    Engine -->|routes requests| LocalAI[Local AI Models];

    Engine -->|manages| Memory[Conversation Memory];
    Engine -->|coordinates| Voice[Voice Processing];
    Engine -->|coordinates| Image[Image Processing];

    Memory --> JSON[JSON Storage];
    Voice --> Whisper[Whisper/GTTS];
    Image --> Pillow[Pillow/Diffusers];

    UI[Streamlit UI] --> Engine;
    Config[Environment Config] --> Engine;

    subgraph "Application Services"
        Streamlit[Streamlit:8501];
        CoreAPI[Core Engine API];
    end

    UI --> Streamlit;
    Engine --> CoreAPI;

    subgraph "External Services"
        GeminiAPI[Gemini API];
        LocalAISvc[Local AI Service];
    end

    Gemini --> GeminiAPI;
    LocalAI --> LocalAISvc;

    style User fill:#e1f5fe
    style Engine fill:#f3e5f5
    style UI fill:#e8f5e8
    style Memory fill:#fff3e0